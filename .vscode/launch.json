{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "0sys --help",
      "type": "debugpy",
      "request": "launch",
      "module": "zerosys",
      "args": ["--help"],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}